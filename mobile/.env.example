# Para usar o Expo Go no celular, informe o IP local do computador que executa a API.
# Exemplo: ipconfig (Windows) ou hostname -I (Linux).
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080/api
# Mesmo IP LAN acima, agora com a porta do Metro exposta pelo Docker.
EXPO_PACKAGER_PROXY_URL=http://192.168.0.10:8081
